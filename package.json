{
  "name": "timetracker-v2",
  "version": "2.0.0",
  "private": true,
  "description": "TimeTracker SaaS v2 - Monorepo with React, Vite, TS, Tailwind, Neon, Prisma",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@timetracker/web",
    "dev:web": "npm run dev --workspace=@timetracker/web",
    "dev:api": "npm run dev --workspace=@timetracker/api",
    "build:api": "esbuild packages/api/src/vercel.ts --bundle --platform=node --target=node18 --format=cjs --external:@prisma/client --external:@neondatabase/serverless --external:@prisma/adapter-neon --outfile=api/index.js",
    "build": "npm run db:generate && npm run build:api && npm run build --workspaces --if-present",
    "postinstall": "npm run db:generate",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run generate --workspace=@timetracker/db",
    "db:migrate": "npm run migrate --workspace=@timetracker/db",
    "db:studio": "npm run studio --workspace=@timetracker/db"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "pdf-lib": "^1.17.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
