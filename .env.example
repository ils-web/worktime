# Database (Neon serverless Postgres)
# Pooled connection URL for serverless execution
DATABASE_URL="postgresql://user:password@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Direct connection URL for Prisma migrations
DIRECT_URL="postgresql://user:password@ep-sample.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Auth & Security
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
CRON_SECRET="replace-with-a-secure-cron-secret-key"

# Web Push (VAPID)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@timetracker.io"

# Vercel Blob (Client logo uploads)
BLOB_READ_WRITE_TOKEN=""

# Email notifications (optional)
EMAIL_USER=""
EMAIL_PASS=""

# Frontend & Environment
NODE_ENV="development"
PORT=3000
